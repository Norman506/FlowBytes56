diff -ruN a/app/src/main/java/com/ray/flowmeter/data/UsageLog.kt b/app/src/main/java/com/ray/flowmeter/data/UsageLog.kt
--- a/app/src/main/java/com/ray/flowmeter/data/UsageLog.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/com/ray/flowmeter/data/UsageLog.kt	2026-11-01 02:56:36.328730835 +0000
@@ -0,0 +1,152 @@
+// Own lightweight log of hourly traffic per app. It is kept outside the Room database on purpose,
+// so it can evolve on its own and never affects the limits and alerts tables.
+package com.ray.flowmeter.data
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.util.Calendar
+
+class UsageLogStore private constructor(context: Context) :
+    SQLiteOpenHelper(context.applicationContext, "usage_log.db", null, 1) {
+
+    data class HourRow(
+        val packageName: String,
+        val appName: String,
+        val bucket: Long,
+        val wifi: Long,
+        val mobile: Long,
+        val background: Long,
+    )
+
+    data class Snap(val day: Long, val wifi: Long, val mobile: Long)
+
+    override fun onCreate(db: SQLiteDatabase) {
+        db.execSQL(
+            "CREATE TABLE hourly_usage (pkg TEXT NOT NULL, name TEXT NOT NULL, bucket INTEGER NOT NULL, " +
+                "wifi INTEGER NOT NULL DEFAULT 0, mobile INTEGER NOT NULL DEFAULT 0, bg INTEGER NOT NULL DEFAULT 0, " +
+                "PRIMARY KEY (pkg, bucket))"
+        )
+        db.execSQL("CREATE INDEX idx_hourly_bucket ON hourly_usage (bucket)")
+        db.execSQL("CREATE TABLE snapshot (pkg TEXT NOT NULL PRIMARY KEY, day INTEGER NOT NULL, wifi INTEGER NOT NULL, mobile INTEGER NOT NULL)")
+        db.execSQL("CREATE TABLE meta (k TEXT NOT NULL PRIMARY KEY, v INTEGER NOT NULL)")
+    }
+
+    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+        // Nothing to migrate yet.
+    }
+
+    @Synchronized
+    fun addUsage(pkg: String, name: String, bucket: Long, wifi: Long, mobile: Long, bg: Long) {
+        val db = writableDatabase
+        db.execSQL(
+            "INSERT OR IGNORE INTO hourly_usage (pkg, name, bucket) VALUES (?, ?, ?)",
+            arrayOf<Any?>(pkg, name, bucket)
+        )
+        db.execSQL(
+            "UPDATE hourly_usage SET wifi = wifi + ?, mobile = mobile + ?, bg = bg + ?, name = ? WHERE pkg = ? AND bucket = ?",
+            arrayOf<Any?>(wifi, mobile, bg, name, pkg, bucket)
+        )
+    }
+
+    @Synchronized
+    fun backgroundInBucket(pkg: String, bucket: Long): Long {
+        readableDatabase.rawQuery(
+            "SELECT bg FROM hourly_usage WHERE pkg = ? AND bucket = ?",
+            arrayOf(pkg, bucket.toString())
+        ).use { c ->
+            return if (c.moveToFirst()) c.getLong(0) else 0L
+        }
+    }
+
+    // Average background bytes of an app at this hour of the day over the previous days: (average, days with data).
+    @Synchronized
+    fun typicalBackground(pkg: String, hourOfDay: Int, beforeBucket: Long, days: Int = 14): Pair<Long, Int> {
+        val from = beforeBucket - days * 24L * 3600_000L
+        var sum = 0L
+        var count = 0
+        val cal = Calendar.getInstance()
+        readableDatabase.rawQuery(
+            "SELECT bucket, bg FROM hourly_usage WHERE pkg = ? AND bucket >= ? AND bucket < ?",
+            arrayOf(pkg, from.toString(), beforeBucket.toString())
+        ).use { c ->
+            while (c.moveToNext()) {
+                cal.timeInMillis = c.getLong(0)
+                if (cal.get(Calendar.HOUR_OF_DAY) == hourOfDay) {
+                    sum += c.getLong(1)
+                    count++
+                }
+            }
+        }
+        return if (count == 0) Pair(0L, 0) else Pair(sum / count, count)
+    }
+
+    @Synchronized
+    fun hoursBetween(from: Long, to: Long): List<HourRow> {
+        val out = ArrayList<HourRow>()
+        readableDatabase.rawQuery(
+            "SELECT pkg, name, bucket, wifi, mobile, bg FROM hourly_usage WHERE bucket >= ? AND bucket < ? ORDER BY bucket",
+            arrayOf(from.toString(), to.toString())
+        ).use { c ->
+            while (c.moveToNext()) {
+                out.add(HourRow(c.getString(0), c.getString(1), c.getLong(2), c.getLong(3), c.getLong(4), c.getLong(5)))
+            }
+        }
+        return out
+    }
+
+    @Synchronized
+    fun loadSnapshots(): Map<String, Snap> {
+        val out = HashMap<String, Snap>()
+        readableDatabase.rawQuery("SELECT pkg, day, wifi, mobile FROM snapshot", null).use { c ->
+            while (c.moveToNext()) {
+                out[c.getString(0)] = Snap(c.getLong(1), c.getLong(2), c.getLong(3))
+            }
+        }
+        return out
+    }
+
+    @Synchronized
+    fun saveSnapshots(map: Map<String, Snap>) {
+        val db = writableDatabase
+        db.beginTransaction()
+        try {
+            for ((pkg, s) in map) {
+                db.execSQL(
+                    "INSERT OR REPLACE INTO snapshot (pkg, day, wifi, mobile) VALUES (?, ?, ?, ?)",
+                    arrayOf<Any?>(pkg, s.day, s.wifi, s.mobile)
+                )
+            }
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    @Synchronized
+    fun getMeta(key: String): Long {
+        readableDatabase.rawQuery("SELECT v FROM meta WHERE k = ?", arrayOf(key)).use { c ->
+            return if (c.moveToFirst()) c.getLong(0) else 0L
+        }
+    }
+
+    @Synchronized
+    fun setMeta(key: String, value: Long) {
+        writableDatabase.execSQL("INSERT OR REPLACE INTO meta (k, v) VALUES (?, ?)", arrayOf<Any?>(key, value))
+    }
+
+    @Synchronized
+    fun prune(beforeBucket: Long) {
+        writableDatabase.delete("hourly_usage", "bucket < ?", arrayOf(beforeBucket.toString()))
+    }
+
+    companion object {
+        @Volatile
+        private var instance: UsageLogStore? = null
+
+        fun get(context: Context): UsageLogStore =
+            instance ?: synchronized(this) {
+                instance ?: UsageLogStore(context).also { instance = it }
+            }
+    }
+}
