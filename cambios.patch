--- a/app/src/main/java/com/ray/flowmeter/data/ConfigBackup.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/com/ray/flowmeter/data/ConfigBackup.kt	2026-11-01 02:56:36.328754165 +0000
@@ -0,0 +1,95 @@
+// Export / import of the user's configuration (limits, schedules, performance mode) to a JSON file.
+package com.ray.flowmeter.data
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+
+object ConfigBackup {
+
+    suspend fun export(context: Context): String = withContext(Dispatchers.IO) {
+        PerformanceModeStore.init(context)
+        val limits = FlowMeterDatabase.getDatabase(context).appLimitDao().getAllAppLimitsList()
+        val root = JSONObject()
+        root.put("version", 1)
+
+        val array = JSONArray()
+        for (l in limits) {
+            val o = JSONObject()
+            o.put("packageName", l.packageName)
+            o.put("appName", l.appName)
+            o.put("dataLimit", l.dataLimit)
+            o.put("limitType", l.limitType)
+            o.put("networkType", l.networkType)
+            o.put("wifiDataLimit", l.wifiDataLimit)
+            o.put("mobileDataLimit", l.mobileDataLimit)
+            o.put("isEnabled", l.isEnabled)
+            o.put("isAlwaysBlocked", l.isAlwaysBlocked)
+            o.put("scheduleEnabled", l.scheduleEnabled)
+            o.put("scheduleDays", l.scheduleDays)
+            o.put("scheduleStartMin", l.scheduleStartMin)
+            o.put("scheduleEndMin", l.scheduleEndMin)
+            array.put(o)
+        }
+        root.put("appLimits", array)
+
+        val perf = JSONObject()
+        perf.put("armed", PerformanceModeStore.armed.value)
+        perf.put("games", JSONArray(PerformanceModeStore.games.value.toList()))
+        perf.put("exceptions", JSONArray(PerformanceModeStore.exceptions.value.toList()))
+        root.put("performance", perf)
+        root.toString(2)
+    }
+
+    // Returns how many app limits were restored.
+    suspend fun import(context: Context, json: String): Int = withContext(Dispatchers.IO) {
+        val root = JSONObject(json)
+        val dao = FlowMeterDatabase.getDatabase(context).appLimitDao()
+        var count = 0
+
+        val array = root.optJSONArray("appLimits")
+        if (array != null) {
+            for (i in 0 until array.length()) {
+                val o = array.getJSONObject(i)
+                val pkg = o.getString("packageName")
+                dao.insert(
+                    AppLimit(
+                        packageName = pkg,
+                        appName = o.optString("appName", pkg),
+                        dataLimit = o.optLong("dataLimit", 0L),
+                        limitType = o.optString("limitType", "daily"),
+                        networkType = o.optString("networkType", "both"),
+                        wifiDataLimit = o.optLong("wifiDataLimit", 0L),
+                        mobileDataLimit = o.optLong("mobileDataLimit", 0L),
+                        isEnabled = o.optBoolean("isEnabled", true),
+                        isAlwaysBlocked = o.optBoolean("isAlwaysBlocked", false),
+                        scheduleEnabled = o.optBoolean("scheduleEnabled", false),
+                        scheduleDays = o.optInt("scheduleDays", 127),
+                        scheduleStartMin = o.optInt("scheduleStartMin", 22 * 60),
+                        scheduleEndMin = o.optInt("scheduleEndMin", 7 * 60),
+                    )
+                )
+                count++
+            }
+        }
+
+        val perf = root.optJSONObject("performance")
+        if (perf != null) {
+            PerformanceModeStore.init(context)
+            PerformanceModeStore.setGames(toSet(perf.optJSONArray("games")))
+            PerformanceModeStore.setExceptions(toSet(perf.optJSONArray("exceptions")))
+            PerformanceModeStore.setArmed(perf.optBoolean("armed", false))
+        }
+        count
+    }
+
+    private fun toSet(array: JSONArray?): Set<String> {
+        val out = HashSet<String>()
+        if (array != null) {
+            for (i in 0 until array.length()) out.add(array.getString(i))
+        }
+        return out
+    }
+}
diff -ruN a/app/src/main/java/com/ray/flowmeter/data/PerformanceModeStore.kt b/app/src/main/java/com/ray/flowmeter/data/PerformanceModeStore.kt
