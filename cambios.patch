+// Every few minutes it reads how much each app used the network, stores it by hour and flags
+// apps that use a lot of data in the background (screen off, or without being opened).
+package com.ray.flowmeter.service
+
+import android.app.usage.NetworkStats
+import android.app.usage.NetworkStatsManager
+import android.app.usage.UsageEvents
+import android.app.usage.UsageStatsManager
+import android.content.Context
+import android.net.ConnectivityManager
+import android.os.Process
+import com.ray.flowmeter.data.UsageLogStore
+import com.ray.flowmeter.utils.BackgroundReasons
+import java.util.Calendar
+
+class UsageSampler(private val context: Context) {
+
+    data class Finding(
+        val packageName: String,
+        val appName: String,
+        val bytes: Long,
+        val typicalBytes: Long,
+        val flags: Long,
+    )
+
+    private class Foreground(val foregroundMs: Map<String, Long>, val lastOpened: Map<String, Long>)
+
+    private val store = UsageLogStore.get(context)
+    private val pm = context.packageManager
+    private val uidCache = HashMap<Int, String?>()
+    private val nameCache = HashMap<String, String>()
+    private val lastAlertAt = HashMap<String, Long>()
+    private var lastSampleAt = 0L
+
+    fun shouldRun(now: Long): Boolean {
+        if (lastSampleAt == 0L) lastSampleAt = store.getMeta(META_LAST_SAMPLE)
+        return now - lastSampleAt >= SAMPLE_INTERVAL_MS
+    }
+
+    // Blocking work: call it from a background thread.
+    fun sample(now: Long, lastScreenOnAt: Long): List<Finding> {
+        val windowStart = if (lastSampleAt == 0L) now - SAMPLE_INTERVAL_MS else lastSampleAt
+        val gap = (now - windowStart) > SAMPLE_INTERVAL_MS * 3
+        lastSampleAt = now
+        store.setMeta(META_LAST_SAMPLE, now)
+
+        val dayStart = startOfDay(now)
+        val current = readCumulative(dayStart, now)
+        val previous = store.loadSnapshots()
+        val foreground = readForeground(windowStart, now)
+        val bucket = hourStart(now - 1)
+        val hourOfDay = hourOf(bucket)
+        val screenOff = lastScreenOnAt < windowStart
+
+        val findings = ArrayList<Finding>()
+        val snapshots = HashMap<String, UsageLogStore.Snap>()
+
+        for ((pkg, usage) in current) {
+            val wifiNow = usage[0]
+            val mobileNow = usage[1]
+            snapshots[pkg] = UsageLogStore.Snap(dayStart, wifiNow, mobileNow)
+
+            // First time we see an app only sets its baseline.
+            val prev = previous[pkg] ?: continue
+            val dWifi: Long
+            val dMobile: Long
+            if (prev.day != dayStart) {
+                dWifi = wifiNow
+                dMobile = mobileNow
+            } else if (wifiNow >= prev.wifi && mobileNow >= prev.mobile) {
+                dWifi = wifiNow - prev.wifi
+                dMobile = mobileNow - prev.mobile
+            } else {
+                continue
+            }
+
+            val total = dWifi + dMobile
+            if (total <= 0L) continue
+
+            // If the app was never on screen during the window, all its traffic is background traffic.
+            val foregroundMs = foreground.foregroundMs[pkg] ?: 0L
+            val background = if (foregroundMs == 0L) total else 0L
+            val name = nameOf(pkg)
+            store.addUsage(pkg, name, bucket, dWifi, dMobile, background)
+
+            if (gap || background == 0L || pkg == context.packageName) continue
+
+            val hourBackground = store.backgroundInBucket(pkg, bucket)
+            val (typical, samples) = store.typicalBackground(pkg, hourOfDay, bucket)
+            val unusual = if (samples >= MIN_HISTORY_SAMPLES) {
+                hourBackground >= maxOf(typical * 3, MIN_BACKGROUND_BYTES)
+            } else {
+                hourBackground >= NO_HISTORY_BYTES
+            }
+            if (!unusual) continue
+
+            val lastAlert = lastAlertAt[pkg] ?: 0L
+            if (now - lastAlert < ALERT_COOLDOWN_MS) continue
+            lastAlertAt[pkg] = now
+
+            var flags = 0L
+            if (screenOff) flags = flags or BackgroundReasons.FLAG_SCREEN_OFF
+            val lastOpened = foreground.lastOpened[pkg] ?: 0L
+            if (now - lastOpened > NOT_OPENED_MS) flags = flags or BackgroundReasons.FLAG_NOT_OPENED
+            if (dMobile > dWifi) flags = flags or BackgroundReasons.FLAG_MOBILE
+            findings.add(Finding(pkg, name, hourBackground, typical, flags))
+        }
+
+        store.saveSnapshots(snapshots)
+        store.prune(now - RETENTION_MS)
+        return findings
+    }
+
+    // Bytes since [start] per package: [wifi, mobile].
+    private fun readCumulative(start: Long, end: Long): Map<String, LongArray> {
+        val result = HashMap<String, LongArray>()
+        val manager = context.getSystemService(NetworkStatsManager::class.java) ?: return result
+        val transports = intArrayOf(ConnectivityManager.TYPE_WIFI, ConnectivityManager.TYPE_MOBILE)
+        for (transport in transports) {
+            try {
+                val stats = manager.querySummary(transport, null, start, end)
+                try {
+                    val bucket = NetworkStats.Bucket()
+                    while (stats.hasNextBucket()) {
+                        stats.getNextBucket(bucket)
+                        val uid = bucket.uid
+                        if (uid == Process.SYSTEM_UID || uid == Process.SHELL_UID) continue
+                        val pkg = packageFor(uid) ?: continue
+                        val entry = result.getOrPut(pkg) { LongArray(2) }
+                        val bytes = bucket.rxBytes + bucket.txBytes
+                        if (transport == ConnectivityManager.TYPE_WIFI) entry[0] += bytes else entry[1] += bytes
+                    }
+                } finally {
+                    stats.close()
+                }
+            } catch (_: Exception) {
+                // Missing permission or unsupported network: skip it.
+            }
+        }
+        return result
+    }
+
+    private fun readForeground(windowStart: Long, now: Long): Foreground {
+        val foregroundMs = HashMap<String, Long>()
+        val lastOpened = HashMap<String, Long>()
+        val resumedAt = HashMap<String, Long>()
+        try {
+            val usm = context.getSystemService(UsageStatsManager::class.java)
+            val events = usm.queryEvents(minOf(windowStart, now - OPENED_LOOKBACK_MS), now)
+            val event = UsageEvents.Event()
+            while (events.hasNextEvent()) {
+                events.getNextEvent(event)
+                val pkg = event.packageName ?: continue
+                when (event.eventType) {
+                    UsageEvents.Event.ACTIVITY_RESUMED -> {
+                        resumedAt[pkg] = event.timeStamp
+                        lastOpened[pkg] = event.timeStamp
+                    }
+                    UsageEvents.Event.ACTIVITY_PAUSED, UsageEvents.Event.ACTIVITY_STOPPED -> {
+                        val start = resumedAt.remove(pkg)
+                        if (start != null) addOverlap(foregroundMs, pkg, start, event.timeStamp, windowStart, now)
+                    }
+                }
+            }
+            for ((pkg, start) in resumedAt) addOverlap(foregroundMs, pkg, start, now, windowStart, now)
+        } catch (_: Exception) {
+            // Without usage events every window is treated as background, so we skip alerts instead.
+        }
+        return Foreground(foregroundMs, lastOpened)
+    }
+
+    private fun addOverlap(map: HashMap<String, Long>, pkg: String, a: Long, b: Long, windowStart: Long, windowEnd: Long) {
+        val overlap = minOf(b, windowEnd) - maxOf(a, windowStart)
+        if (overlap > 0L) map[pkg] = (map[pkg] ?: 0L) + overlap
+    }
+
+    private fun packageFor(uid: Int): String? {
+        if (uidCache.containsKey(uid)) return uidCache[uid]
+        val pkg = try {
+            pm.getPackagesForUid(uid)?.firstOrNull()
+        } catch (_: Exception) {
+            null
+        }
+        uidCache[uid] = pkg
+        return pkg
+    }
+
+    private fun nameOf(pkg: String): String = nameCache.getOrPut(pkg) {
+        try {
+            pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0)).toString()
+        } catch (_: Exception) {
+            pkg
+        }
+    }
+
+    private fun startOfDay(ms: Long): Long {
+        val cal = Calendar.getInstance()
+        cal.timeInMillis = ms
+        cal.set(Calendar.HOUR_OF_DAY, 0)
+        cal.set(Calendar.MINUTE, 0)
+        cal.set(Calendar.SECOND, 0)
+        cal.set(Calendar.MILLISECOND, 0)
+        return cal.timeInMillis
+    }
+
+    private fun hourStart(ms: Long): Long {
+        val cal = Calendar.getInstance()
+        cal.timeInMillis = ms
+        cal.set(Calendar.MINUTE, 0)
+        cal.set(Calendar.SECOND, 0)
+        cal.set(Calendar.MILLISECOND, 0)
+        return cal.timeInMillis
+    }
+
+    private fun hourOf(ms: Long): Int {
+        val cal = Calendar.getInstance()
+        cal.timeInMillis = ms
+        return cal.get(Calendar.HOUR_OF_DAY)
+    }
+
+    companion object {
+        private const val META_LAST_SAMPLE = "last_sample"
+        private const val SAMPLE_INTERVAL_MS = 15 * 60_000L
+        private const val RETENTION_MS = 35L * 24 * 3600_000L
+        private const val OPENED_LOOKBACK_MS = 6 * 3600_000L
+        private const val NOT_OPENED_MS = 6 * 3600_000L
+        private const val ALERT_COOLDOWN_MS = 3 * 3600_000L
+        private const val MIN_HISTORY_SAMPLES = 3
+        private const val MIN_BACKGROUND_BYTES = 8L * 1024 * 1024
+        private const val NO_HISTORY_BYTES = 30L * 1024 * 1024
+    }
+}
