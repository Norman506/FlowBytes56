+    // Weekly block schedule. scheduleDays is a bitmask: bit 0 = Monday ... bit 6 = Sunday.
+    // Times are minutes since midnight; if end < start, the block runs overnight.
+    val scheduleEnabled: Boolean = false,
+    val scheduleDays: Int = 127,
+    val scheduleStartMin: Int = 22 * 60,
+    val scheduleEndMin: Int = 7 * 60,
+) {
+    // True when [now] falls inside this app's block schedule.
+    fun isScheduleActive(now: Calendar): Boolean {
+        if (!scheduleEnabled) return false
+        val minutes = now.get(Calendar.HOUR_OF_DAY) * 60 + now.get(Calendar.MINUTE)
+        val today = (now.get(Calendar.DAY_OF_WEEK) + 5) % 7 // Monday = 0 ... Sunday = 6
+        val yesterday = (today + 6) % 7
+        fun dayOn(d: Int) = ((scheduleDays shr d) and 1) == 1
+        return when {
+            scheduleStartMin == scheduleEndMin -> dayOn(today) // whole day
+            scheduleStartMin < scheduleEndMin ->
+                dayOn(today) && minutes >= scheduleStartMin && minutes < scheduleEndMin
+            else -> // overnight window
+                (dayOn(today) && minutes >= scheduleStartMin) ||
+                    (dayOn(yesterday) && minutes < scheduleEndMin)
+        }
+    }
+}
 
