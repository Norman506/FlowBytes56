+            Switch(checked = limit.isEnabled, onCheckedChange = onToggle)
+            Spacer(Modifier.width(4.dp))
+            IconButton(onClick = onRemove) {
+                Icon(Icons.Rounded.Delete, contentDescription = null, tint = MaterialTheme.colorScheme.error)
+            }
+        }
+    }
+}
+
+// Full-screen picker like the one used for app limits: icon, name, package and a checkbox per app.
+@Composable
+fun BlockedAppsPickerDialog(
+    title: String,
+    apps: List<AppLimitsViewModel.AppInfo>,
+    onDismiss: () -> Unit,
+    onConfirm: (List<AppLimitsViewModel.AppInfo>) -> Unit,
+) {
+    var query by remember { mutableStateOf("") }
+    var selected by remember { mutableStateOf(setOf<String>()) }
+    val shown = if (query.isBlank()) apps
+    else apps.filter { it.name.contains(query, ignoreCase = true) || it.packageName.contains(query, ignoreCase = true) }
+
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false),
+    ) {
+        Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .statusBarsPadding()
+                    .navigationBarsPadding()
+                    .imePadding()
+                    .padding(horizontal = 16.dp)
+            ) {
+                Spacer(Modifier.height(8.dp))
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) }
+                    Spacer(Modifier.width(8.dp))
+                    Text(
+                        title,
+                        style = MaterialTheme.typography.titleLarge,
+                        fontWeight = FontWeight.Bold,
+                        modifier = Modifier.weight(1f),
+                        maxLines = 2,
+                    )
+                }
+                Spacer(Modifier.height(8.dp))
+                OutlinedTextField(
+                    value = query,
+                    onValueChange = { query = it },
+                    singleLine = true,
+                    placeholder = { Text(stringResource(R.string.placeholder_search_apps)) },
+                    shape = RoundedCornerShape(28.dp),
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Spacer(Modifier.height(8.dp))
+                LazyColumn(
+                    modifier = Modifier.weight(1f),
+                    verticalArrangement = Arrangement.spacedBy(4.dp),
+                ) {
+                    items(shown, key = { it.packageName }) { app ->
+                        val isOn = app.packageName in selected
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    selected = if (isOn) selected - app.packageName else selected + app.packageName
+                                }
+                                .padding(vertical = 8.dp),
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            AppIconCircle(app.packageName, size = 52.dp)
+                            Spacer(Modifier.width(16.dp))
+                            Column(modifier = Modifier.weight(1f)) {
+                                Text(
+                                    app.name,
+                                    style = MaterialTheme.typography.titleMedium,
+                                    fontWeight = FontWeight.Bold,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                )
+                                Text(
+                                    app.packageName,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                )
+                            }
+                            Checkbox(
+                                checked = isOn,
+                                onCheckedChange = {
+                                    selected = if (isOn) selected - app.packageName else selected + app.packageName
+                                },
+                            )
+                        }
+                    }
+                }
+                Button(
+                    enabled = selected.isNotEmpty(),
+                    onClick = { onConfirm(apps.filter { it.packageName in selected }) },
+                    modifier = Modifier.fillMaxWidth().padding(vertical = 12.dp),
+                ) {
+                    Text(stringResource(android.R.string.ok) + " (" + selected.size + ")")
+                }
