+// Plain-language explanation of why a background usage alert was raised.
+package com.ray.flowmeter.utils
+
+import android.content.Context
+import com.ray.flowmeter.R
+
+object BackgroundReasons {
+    const val FLAG_SCREEN_OFF = 1L
+    const val FLAG_NOT_OPENED = 2L
+    const val FLAG_MOBILE = 4L
+
+    fun describe(context: Context, flags: Long, typicalBytes: Long, format: (Long) -> String): String {
+        val parts = ArrayList<String>()
+        if ((flags and FLAG_SCREEN_OFF) != 0L) parts.add(context.getString(R.string.reason_screen_off))
+        if ((flags and FLAG_NOT_OPENED) != 0L) parts.add(context.getString(R.string.reason_not_opened))
+        if (typicalBytes > 0L) {
+            parts.add(context.getString(R.string.reason_usually, format(typicalBytes)))
+        } else {
+            parts.add(context.getString(R.string.reason_no_history))
+        }
+        if ((flags and FLAG_MOBILE) != 0L) parts.add(context.getString(R.string.reason_mobile))
+        return parts.joinToString(" · ")
+    }
+}
