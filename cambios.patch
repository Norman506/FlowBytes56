+@Composable
+fun UsageInsightsDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val store = remember { UsageLogStore.get(context) }
+    val now = remember { System.currentTimeMillis() }
+    var tab by remember { mutableIntStateOf(0) }
+    val rows by produceState(initialValue = emptyList<UsageLogStore.HourRow>()) {
+        value = withContext(Dispatchers.IO) { store.hoursBetween(now - 15 * DAY_MS, now + HOUR_MS) }
+    }
+
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false),
+    ) {
+        Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(modifier = Modifier.fillMaxSize().padding(horizontal = 16.dp)) {
+                Spacer(Modifier.height(40.dp))
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    IconButton(onClick = onDismiss) { Icon(Icons.Rounded.Close, contentDescription = null) }
+                    Text(
+                        stringResource(R.string.insights_title),
+                        style = MaterialTheme.typography.titleLarge,
+                        fontWeight = FontWeight.Bold,
+                    )
+                }
+                TabRow(selectedTabIndex = tab) {
+                    Tab(
+                        selected = tab == 0,
+                        onClick = { tab = 0 },
+                        text = { Text(stringResource(R.string.tab_by_hour)) },
+                    )
+                    Tab(
+                        selected = tab == 1,
+                        onClick = { tab = 1 },
+                        text = { Text(stringResource(R.string.tab_week)) },
+                    )
+                }
+                if (rows.isEmpty()) {
+                    Box(modifier = Modifier.fillMaxSize().padding(24.dp), contentAlignment = Alignment.Center) {
+                        Text(
+                            stringResource(R.string.insights_empty),
+                            textAlign = TextAlign.Center,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                } else if (tab == 0) {
+                    HourlyTab(rows, now)
+                } else {
+                    WeekTab(rows, now)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun HourlyTab(rows: List<UsageLogStore.HourRow>, now: Long) {
+    val context = LocalContext.current
+    val todayStart = remember(now) { startOfDay(now) }
+    val today = remember(rows) { rows.filter { it.bucket >= todayStart } }
+    val ranking = remember(today) {
+        today.groupBy { it.packageName }
+            .map { (pkg, list) -> Triple(pkg, list.first().appName, list.sumOf { it.wifi + it.mobile }) }
+            .sortedByDescending { it.third }
+    }
+    var selected by remember { mutableStateOf<String?>(null) }
+    val scoped = if (selected == null) today else today.filter { it.packageName == selected }
+    val perHour = LongArray(24)
+    val cal = Calendar.getInstance()
+    scoped.forEach {
+        cal.timeInMillis = it.bucket
+        perHour[cal.get(Calendar.HOUR_OF_DAY)] += it.wifi + it.mobile
+    }
+    val total = perHour.sum()
+    val peak = if (total > 0L) perHour.indices.maxByOrNull { perHour[it] } ?: -1 else -1
+
+    Column(
+        modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(top = 12.dp, bottom = 24.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        Row(modifier = Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            FilterChip(
+                selected = selected == null,
+                onClick = { selected = null },
+                label = { Text(stringResource(R.string.insights_all_apps)) },
+            )
+            ranking.take(8).forEach { (pkg, name, _) ->
+                FilterChip(
+                    selected = selected == pkg,
+                    onClick = { selected = pkg },
+                    label = { Text(name, maxLines = 1) },
+                )
+            }
+        }
+        Text(
+            stringResource(R.string.insights_today_total, Formatter.formatShortFileSize(context, total)),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.SemiBold,
+        )
+        BarChart(
+            values = perHour.toList(),
+            labelEvery = 6,
+            labelOf = { it.toString() },
+            highlight = peak,
+        )
+        if (peak >= 0) {
+            Text(
+                stringResource(
+                    R.string.insights_peak_line,
+                    hourLabel(peak),
+                    Formatter.formatShortFileSize(context, perHour[peak])
+                ),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        Text(
+            stringResource(R.string.insights_apps_title),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.SemiBold,
+        )
+        ranking.take(15).forEach { (pkg, name, appTotal) ->
+            val peakHour = peakHourOf(today.filter { it.packageName == pkg })
+            InsightAppRow(
+                pkg = pkg,
+                name = name,
+                total = appTotal,
+                subtitle = if (peakHour != null) stringResource(R.string.insights_peak_short, hourLabel(peakHour)) else "",
+            )
+        }
+    }
+}
+
+@Composable
+private fun WeekTab(rows: List<UsageLogStore.HourRow>, now: Long) {
+    val context = LocalContext.current
+    val weekStart = remember(now) {
+        val c = Calendar.getInstance()
+        c.timeInMillis = startOfDay(now)
+        c.add(Calendar.DAY_OF_YEAR, -6)
+        c.timeInMillis
+    }
+    val prevStart = remember(weekStart) {
+        val c = Calendar.getInstance()
+        c.timeInMillis = weekStart
+        c.add(Calendar.DAY_OF_YEAR, -7)
+        c.timeInMillis
+    }
+    val week = remember(rows) { rows.filter { it.bucket >= weekStart } }
+    val previous = remember(rows) { rows.filter { it.bucket >= prevStart && it.bucket < weekStart } }
+    val wifi = week.sumOf { it.wifi }
+    val mobile = week.sumOf { it.mobile }
+    val background = week.sumOf { it.background }
+    val total = wifi + mobile
+    val previousTotal = previous.sumOf { it.wifi + it.mobile }
+
+    val perDay = LongArray(7)
+    week.forEach {
+        val index = ((it.bucket - weekStart) / DAY_MS).toInt().coerceIn(0, 6)
+        perDay[index] += it.wifi + it.mobile
+    }
+    val dayFormat = remember { SimpleDateFormat("EEE", Locale.getDefault()) }
+    val dayLabels = (0..6).map { dayFormat.format(weekStart + it * DAY_MS + 12 * HOUR_MS) }
+
+    val ranking = remember(week) {
+        week.groupBy { it.packageName }.map { (pkg, list) ->
+            AppWeek(
+                pkg = pkg,
+                name = list.first().appName,
+                wifi = list.sumOf { it.wifi },
+                mobile = list.sumOf { it.mobile },
+                background = list.sumOf { it.background },
+                peakHour = peakHourOf(list),
+            )
+        }.sortedByDescending { it.wifi + it.mobile }
+    }
+
+    Column(
+        modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(top = 12.dp, bottom = 24.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        Text(
+            stringResource(R.string.insights_week_total, Formatter.formatShortFileSize(context, total)),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.SemiBold,
+        )
+        Text(
+            stringResource(
+                R.string.insights_split,
+                Formatter.formatShortFileSize(context, mobile),
+                Formatter.formatShortFileSize(context, wifi)
+            ),
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        if (total > 0L) {
+            Text(
+                stringResource(R.string.insights_background_share, (background * 100 / total).toInt()),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        if (previousTotal > 0L) {
+            val change = ((total - previousTotal) * 100 / previousTotal).toInt()
+            Text(
+                stringResource(R.string.insights_vs_last_week, String.format(Locale.getDefault(), "%+d", change)),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        BarChart(
+            values = perDay.toList(),
+            labelEvery = 1,
+            labelOf = { dayLabels[it] },
+            highlight = perDay.indices.maxByOrNull { perDay[it] } ?: -1,
+        )
+        Text(
+            stringResource(R.string.insights_apps_title),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.SemiBold,
+        )
+        ranking.take(15).forEach { app ->
+            val appTotal = app.wifi + app.mobile
+            val share = if (appTotal > 0L) (app.background * 100 / appTotal).toInt() else 0
+            val peakText = if (app.peakHour != null) " · " + stringResource(R.string.insights_peak_short, hourLabel(app.peakHour)) else ""
+            InsightAppRow(
+                pkg = app.pkg,
+                name = app.name,
+                total = appTotal,
+                subtitle = stringResource(
+                    R.string.insights_split,
+                    Formatter.formatShortFileSize(context, app.mobile),
+                    Formatter.formatShortFileSize(context, app.wifi)
+                ) + " · " + stringResource(R.string.insights_background_share, share) + peakText,
+            )
+        }
+    }
+}
+
+private class AppWeek(
+    val pkg: String,
+    val name: String,
+    val wifi: Long,
+    val mobile: Long,
+    val background: Long,
+    val peakHour: Int?,
+)
+
+@Composable
+private fun InsightAppRow(pkg: String, name: String, total: Long, subtitle: String) {
+    val context = LocalContext.current
+    Row(
+        modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        AppIconCircle(pkg, size = 40.dp)
+        Spacer(Modifier.width(12.dp))
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                name,
+                style = MaterialTheme.typography.titleSmall,
+                fontWeight = FontWeight.SemiBold,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            if (subtitle.isNotEmpty()) {
+                Text(
+                    subtitle,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+        }
+        Spacer(Modifier.width(8.dp))
+        Text(Formatter.formatShortFileSize(context, total), style = MaterialTheme.typography.titleSmall)
+    }
+}
+
+@Composable
+private fun BarChart(values: List<Long>, labelEvery: Int, labelOf: (Int) -> String, highlight: Int) {
+    val max = (values.maxOrNull() ?: 0L).coerceAtLeast(1L)
+    Row(
+        modifier = Modifier.fillMaxWidth().height(140.dp),
+        horizontalArrangement = Arrangement.spacedBy(2.dp),
+        verticalAlignment = Alignment.Bottom,
+    ) {
+        values.forEachIndexed { index, value ->
+            val fraction = if (value <= 0L) 0.02f else (value.toFloat() / max).coerceIn(0.04f, 1f)
+            Box(
+                modifier = Modifier
+                    .weight(1f)
+                    .fillMaxHeight(fraction)
+                    .clip(RoundedCornerShape(topStart = 3.dp, topEnd = 3.dp))
+                    .background(
+                        if (index == highlight) MaterialTheme.colorScheme.primary
+                        else MaterialTheme.colorScheme.primary.copy(alpha = 0.4f)
+                    )
+            )
+        }
+    }
+    Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(2.dp)) {
+        values.indices.forEach { index ->
+            Text(
+                if (index % labelEvery == 0) labelOf(index) else "",
+                modifier = Modifier.weight(1f),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                maxLines = 1,
+                softWrap = false,
+            )
+        }
+    }
+}
