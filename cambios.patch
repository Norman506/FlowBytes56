+    // Fully blocks the given apps (no internet at all) using an "unlimited" data limit plus the always-blocked flag.
+    fun blockAppsCompletely(apps: List<AppInfo>) {
+        viewModelScope.launch {
+            val unlimited = 1024L * 1024L * 1024L * 1024L
+            apps.forEach { app ->
+                val existing = repository.getAppLimit(app.packageName)
+                if (existing == null) {
+                    repository.insert(
+                        AppLimit(
+                            packageName = app.packageName,
+                            appName = app.name,
+                            dataLimit = unlimited,
+                            limitType = "daily",
+                            networkType = "both",
+                            wifiDataLimit = unlimited,
+                            mobileDataLimit = unlimited,
+                            isAlwaysBlocked = true,
+                        )
+                    )
+                } else {
+                    repository.update(existing.copy(isAlwaysBlocked = true, isEnabled = true))
+                }
+            }
+        }
+    }
+
+    // Removes the full block; entries that only existed for the block are deleted.
+    fun unblockApp(limit: AppLimit) {
+        viewModelScope.launch {
+            val unlimited = 1024L * 1024L * 1024L * 1024L
+            if (limit.dataLimit >= unlimited && !limit.scheduleEnabled) {
+                repository.delete(limit)
+            } else {
+                repository.update(limit.copy(isAlwaysBlocked = false))
+            }
+        }
+    }
+
