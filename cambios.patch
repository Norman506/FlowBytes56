@@ -0,0 +1,55 @@
+// Settings and live state of the performance mode, shared between the screen and the VPN service.
+package com.ray.flowmeter.data
+
+import android.content.Context
+import android.content.SharedPreferences
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+object PerformanceModeStore {
+    private const val PREFS = "performance_mode"
+    private var prefs: SharedPreferences? = null
+
+    private val _armed = MutableStateFlow(false)
+    val armed: StateFlow<Boolean> = _armed
+
+    private val _games = MutableStateFlow<Set<String>>(emptySet())
+    val games: StateFlow<Set<String>> = _games
+
+    private val _exceptions = MutableStateFlow<Set<String>>(emptySet())
+    val exceptions: StateFlow<Set<String>> = _exceptions
+
+    // True only while a listed game is in the foreground and the other apps are being cut.
+    private val _active = MutableStateFlow(false)
+    val active: StateFlow<Boolean> = _active
+
+    @Synchronized
+    fun init(context: Context) {
+        if (prefs != null) return
+        val p = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        prefs = p
+        _armed.value = p.getBoolean("armed", false)
+        _games.value = p.getStringSet("games", emptySet())?.toSet() ?: emptySet()
+        _exceptions.value = p.getStringSet("exceptions", emptySet())?.toSet() ?: emptySet()
+    }
+
+    fun setArmed(value: Boolean) {
+        _armed.value = value
+        prefs?.edit()?.putBoolean("armed", value)?.apply()
+        if (!value) _active.value = false
+    }
+
+    fun setGames(value: Set<String>) {
+        _games.value = value
+        prefs?.edit()?.putStringSet("games", HashSet(value))?.apply()
+    }
+
+    fun setExceptions(value: Set<String>) {
+        _exceptions.value = value
+        prefs?.edit()?.putStringSet("exceptions", HashSet(value))?.apply()
+    }
+
+    fun setActive(value: Boolean) {
+        _active.value = value
+    }
+}
