+    private val foregroundDetector by lazy { ForegroundAppDetector(applicationContext) }
+    private var lastGameSeenAt = 0L
+    private var internetPackagesCache: List<String> = emptyList()
+    private var internetPackagesAt = 0L
+    private val performanceExitDelayMs = 15_000L
+
+    // Performance mode: while a chosen game is on screen (mobile data only) every other app is cut,
+    // except the exceptions. It stays active a few seconds after leaving the game.
+    private fun performanceBlockedApps(isMobile: Boolean, now: Long): List<String> {
+        val games = PerformanceModeStore.games.value
+        if (!PerformanceModeStore.armed.value || !isMobile || games.isEmpty()) {
+            PerformanceModeStore.setActive(false)
+            lastGameSeenAt = 0L
+            return emptyList()
+        }
+        val foreground = foregroundDetector.currentApp(now)
+        if (foreground != null && foreground in games) lastGameSeenAt = now
+        val active = lastGameSeenAt != 0L && now - lastGameSeenAt < performanceExitDelayMs
+        PerformanceModeStore.setActive(active)
+        if (!active) return emptyList()
+        val exceptions = PerformanceModeStore.exceptions.value
+        return internetPackages(now).filter { it !in games && it !in exceptions && it != packageName }
+    }
+
+    // Installed apps that can use the internet. Cached for a minute because scanning them is slow.
+    private fun internetPackages(now: Long): List<String> {
+        if (now - internetPackagesAt < 60_000L && internetPackagesCache.isNotEmpty()) return internetPackagesCache
+        val list = try {
+            packageManager.getInstalledPackages(android.content.pm.PackageManager.GET_PERMISSIONS)
+                .filter { info -> info.requestedPermissions?.contains(android.Manifest.permission.INTERNET) == true }
+                .map { it.packageName }
+        } catch (_: Exception) {
+            emptyList()
+        }
+        internetPackagesCache = list
+        internetPackagesAt = now
+        return list
+    }
